# GGSIPU Result Checker
# MongoDB Configuration for User Credential Storage
# Replace <username>, <password>, <cluster-url>, and <database-name> with your actual MongoDB credentials
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database-name>?retryWrites=true&w=majority

# Alternative for local MongoDB:
# MONGODB_URI=mongodb://localhost:27017/ggsipu-results

# Note: Data is fetched directly from the official GGSIPU exam portal
# MongoDB is used only for storing user credentials securely (optional feature)
